# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# --- Neon Postgres --------------------------------------------------------
# Neon console -> Connection string -> "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# In local development the frontend and API share localhost, so relax these:
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seeded once by `python -m app.seed`. Change the password after first sign-in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-passphrase
ADMIN_NAME=Emmanuel Kiriinya

# --- CORS -----------------------------------------------------------------
# Comma-separated. Add the Vercel production and preview domains in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Cloudflare R2 --------------------------------------------------------
# Use STORAGE_BACKEND=local while developing to write to ./media instead.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-media
# Your R2 public bucket domain, e.g. https://media.yourdomain.com
R2_PUBLIC_BASE_URL=

MAX_UPLOAD_BYTES=8388608
