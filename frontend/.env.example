# The FastAPI service. In production this is your Render URL.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public site URL — used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostname of your R2 public bucket (no protocol), so next/image will load it.
# e.g. media.emmanuelkiriinya.com
NEXT_PUBLIC_MEDIA_HOST=
